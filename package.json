{
  "name": "gptpark-blogging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "dist": "vite build && electron-builder --win nsis -c.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@google/genai": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "pretendard": "^1.3.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "GPT Park 올인원 블로깅 어시스턴트",
  "author": "GPT Park",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.gptpark.blogging",
    "productName": "GPT Park 블로깅",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
